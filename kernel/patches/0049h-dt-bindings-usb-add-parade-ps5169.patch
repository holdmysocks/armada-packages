From: Armada <noreply@armada.local>
Subject: [PATCH] dt-bindings: usb: add Parade PS5169 redriver

Document the Parade PS5169 USB and DisplayPort linear redriver, including
its Type-C switch roles and input/output endpoint graph.

Signed-off-by: Armada <noreply@armada.local>

diff --git a/Documentation/devicetree/bindings/usb/parade,ps5169.yaml b/Documentation/devicetree/bindings/usb/parade,ps5169.yaml
new file mode 100644
index 000000000..67f516700
--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/parade,ps5169.yaml
@@ -0,0 +1,90 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/parade,ps5169.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Parade PS5169 USB and DisplayPort linear redriver
+
+maintainers:
+  - map220v <map220v300@gmail.com>
+
+properties:
+  compatible:
+    const: parade,ps5169
+
+  reg:
+    maxItems: 1
+
+  dvdd-supply:
+    description: Optional digital core power supply
+
+  reset-gpios:
+    maxItems: 1
+
+  orientation-switch: true
+  retimer-switch: true
+
+  ports:
+    $ref: /schemas/graph.yaml#/properties/ports
+    properties:
+      port@0:
+        $ref: /schemas/graph.yaml#/properties/port
+        description: SuperSpeed output endpoints to the Type-C connectors
+
+      port@1:
+        $ref: /schemas/graph.yaml#/$defs/port-base
+        description: SuperSpeed input endpoint from the USB/DisplayPort PHY
+        unevaluatedProperties: false
+
+        properties:
+          endpoint:
+            $ref: /schemas/graph.yaml#/$defs/endpoint-base
+            unevaluatedProperties: false
+
+            properties:
+              data-lanes:
+                $ref: /schemas/types.yaml#/definitions/uint32-array
+                minItems: 4
+                maxItems: 4
+                uniqueItems: true
+                items:
+                  maximum: 3
+
+required:
+  - compatible
+  - reg
+  - orientation-switch
+  - retimer-switch
+  - ports
+
+allOf:
+  - $ref: usb-switch.yaml#
+  - $ref: usb-switch-ports.yaml#
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        typec-retimer@30 {
+            compatible = "parade,ps5169";
+            reg = <0x30>;
+
+            retimer-switch;
+            orientation-switch;
+
+            ports {
+                #address-cells = <1>;
+                #size-cells = <0>;
+
+                port@0 {
+                    reg = <0>;
+                    retimer_out: endpoint {
+                        remote-endpoint = <&typec_con_ss>;
+                    };
+                };
+
