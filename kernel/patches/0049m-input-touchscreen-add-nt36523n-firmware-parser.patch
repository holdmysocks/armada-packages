From: Armada <noreply@armada.local>
Subject: [PATCH] Input: touchscreen: validate NT36523N firmware layouts

Add an allocation-free parser for the Novatek NT36523N firmware header.
Decode the fixed ILM and DLM records, information descriptors, verified
two-half cascade headers, and the overlay table without requesting firmware
or communicating with hardware.

Treat nonzero encoded sizes as length-minus-one and zero as a reserved
region. Validate the complete layout, including the firmware version
complement, descriptor spans, payload ranges and 32-bit SRAM ranges. Bound
the region count before publishing caller-owned output.

The validated result exposes cascade mode so a future transport can choose
the required auto-copy flow without re-reading untrusted bytes.

Exercise the format using synthetic KUnit data only. Cover truncated and
malformed headers, exact-end payloads, reserved records, overflow, exact
cascade halves, overlay flags and bounds, capacity limits, software
checksums, hardware CRC metadata, layout metadata and output atomicity.
Large synthetic objects are test-managed allocations rather than kernel
stack objects. This patch does not add a transport, firmware request, power
sequencing, panel integration, device enablement or proprietary firmware.
---
diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index da741d0f6..0fc862a78 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -721,6 +721,23 @@ config TOUCHSCREEN_NT36523N_KUNIT_TEST
 
 	  If unsure, say N.
 
+config TOUCHSCREEN_NT36523N_FIRMWARE
+	tristate
+	help
+	  Internal parser for Novatek NT36523N firmware layouts.
+
+config TOUCHSCREEN_NT36523N_FIRMWARE_KUNIT_TEST
+	tristate "KUnit tests for the Novatek NT36523N firmware parser" if !KUNIT_ALL_TESTS
+	depends on KUNIT
+	default KUNIT_ALL_TESTS
+	select TOUCHSCREEN_NT36523N_FIRMWARE
+	help
+	  Build unit tests for the allocation-free Novatek NT36523N firmware
+	  layout parser. The tests use synthetic byte arrays and do not request
+	  firmware or communicate with a touchscreen controller.
+
+	  If unsure, say N.
+
 config TOUCHSCREEN_IMAGIS
 	tristate "Imagis touchscreen support"
 	depends on I2C
diff --git a/drivers/input/touchscreen/Makefile b/drivers/input/touchscreen/Makefile
index 3326c9512..4d08c2156 100644
--- a/drivers/input/touchscreen/Makefile
+++ b/drivers/input/touchscreen/Makefile
@@ -71,6 +71,8 @@ obj-$(CONFIG_TOUCHSCREEN_MTOUCH)	+= mtouch.o
 obj-$(CONFIG_TOUCHSCREEN_NOVATEK_NVT_TS)	+= novatek-nvt-ts.o
 obj-$(CONFIG_TOUCHSCREEN_NT36523N_REPORT) += novatek-nt36523n-report.o
 obj-$(CONFIG_TOUCHSCREEN_NT36523N_KUNIT_TEST) += novatek-nt36523n-report-test.o
+obj-$(CONFIG_TOUCHSCREEN_NT36523N_FIRMWARE) += novatek-nt36523n-firmware.o
+obj-$(CONFIG_TOUCHSCREEN_NT36523N_FIRMWARE_KUNIT_TEST) += novatek-nt36523n-firmware-test.o
 obj-$(CONFIG_TOUCHSCREEN_HP600)		+= hp680_ts_input.o
 obj-$(CONFIG_TOUCHSCREEN_HP7XX)		+= jornada720_ts.o
 obj-$(CONFIG_TOUCHSCREEN_IPAQ_MICRO)	+= ipaq-micro-ts.o
diff --git a/drivers/input/touchscreen/novatek-nt36523n-firmware-test.c b/drivers/input/touchscreen/novatek-nt36523n-firmware-test.c
new file mode 100644
index 000000000..53f5f693e
--- /dev/null
+++ b/drivers/input/touchscreen/novatek-nt36523n-firmware-test.c
@@ -0,0 +1,543 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <kunit/test.h>
+#include <linux/errno.h>
+#include <linux/module.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "novatek-nt36523n-firmware.h"
+
+#define TEST_FW_SIZE	0x1100
+#define DESC_SIZE	0x10
+
+static const struct nt36523n_fw_parse_options sw_options = {
+	.max_regions = NT36523N_FW_MAX_REGIONS,
+};
+
+static const struct nt36523n_fw_parse_options hw_options = {
+	.hardware_crc = true,
+	.max_regions = NT36523N_FW_MAX_REGIONS,
+};
+
+static void set_fixed(u8 *data, unsigned int index, u32 file_offset,
+		      u32 sram_addr, u32 encoded_size, u32 checksum)
+{
+	put_unaligned_le32(file_offset, data + index * 12);
+	put_unaligned_le32(sram_addr, data + index * 12 + 4);
+	put_unaligned_le32(encoded_size, data + index * 12 + 8);
+	put_unaligned_le32(checksum, data + 0x18 + index * 4);
+}
+
+static void set_desc(u8 *data, size_t offset, u32 sram_addr,
+		     u32 encoded_size, u32 file_offset, u32 checksum)
+{
+	put_unaligned_le32(sram_addr, data + offset);
+	put_unaligned_le32(encoded_size, data + offset + 4);
+	put_unaligned_le32(file_offset, data + offset + 8);
+	put_unaligned_le32(checksum, data + offset + 12);
+}
+
+static void make_minimal(u8 *data, size_t len)
+{
+	memset(data, 0, len);
+	data[len - 4096] = 0x55;
+	data[len - 4096 + 1] = 0xaa;
+	set_fixed(data, 0, 0x30, 0x1000, 0x0f, 0x11111111);
+	set_fixed(data, 1, 0x40, 0x2000, 0x0f, 0x22222222);
+}
+
+static void make_cascade(u8 *data, size_t len)
+{
+	make_minimal(data, len);
+	set_fixed(data, 0, 0x80, 0x1000, 0x0f, 0x11111111);
+	data[0x20] = BIT(1);
+	set_desc(data, 0x30, 0, 0x3f, 0, 0x33333333);
+	set_desc(data, 0x70, 0, 0x3f, 0x40, 0x44444444);
+}
+
+static void nt36523n_fw_short_header_test(struct kunit *test)
+{
+	u8 data[0x30] = {};
+	struct nt36523n_fw_region regions[2];
+	struct nt36523n_fw_region before[2];
+	size_t count;
+	size_t len;
+
+	memset(regions, 0xa5, sizeof(regions));
+	memcpy(before, regions, sizeof(before));
+	for (len = 0; len < sizeof(data); len++) {
+		count = 91;
+		KUNIT_EXPECT_EQ(test,
+				nt36523n_fw_parse_regions(data, len, &sw_options,
+							  regions, ARRAY_SIZE(regions),
+						   &count),
+			-EMSGSIZE);
+		KUNIT_EXPECT_EQ(test, count, (size_t)91);
+		KUNIT_EXPECT_MEMEQ(test, regions, before, sizeof(regions));
+	}
+}
+
+static void nt36523n_fw_minimal_test(struct kunit *test)
+{
+	u8 *data;
+	struct nt36523n_fw_region regions[2];
+	struct nt36523n_fw_layout layout;
+	size_t count = 0;
+
+	data = kunit_kzalloc(test, TEST_FW_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	make_minimal(data, TEST_FW_SIZE);
+	KUNIT_ASSERT_EQ(test,
+			nt36523n_fw_parse_regions(data, TEST_FW_SIZE, &hw_options,
+						  regions, ARRAY_SIZE(regions), &count), 0);
+	KUNIT_EXPECT_EQ(test, count, (size_t)2);
+	KUNIT_EXPECT_EQ(test, regions[0].kind, NT36523N_FW_REGION_ILM);
+	KUNIT_EXPECT_EQ(test, regions[0].file_offset, (size_t)0x30);
+	KUNIT_EXPECT_EQ(test, regions[0].payload_len, (size_t)0x10);
+	KUNIT_EXPECT_EQ(test, regions[0].checksum, (u32)0x11111111);
+	KUNIT_EXPECT_EQ(test, regions[1].kind, NT36523N_FW_REGION_DLM);
+	KUNIT_EXPECT_EQ(test, regions[1].file_offset, (size_t)0x40);
+	KUNIT_ASSERT_EQ(test,
+			nt36523n_fw_parse_layout(data, TEST_FW_SIZE, &hw_options,
+						 &layout), 0);
+	KUNIT_EXPECT_FALSE(test, layout.cascade);
+	KUNIT_EXPECT_EQ(test, layout.region_count, (size_t)2);
+}
+
+static void nt36523n_fw_version_pair_test(struct kunit *test)
+{
+	u8 *data;
+	struct nt36523n_fw_layout layout = {
+		.cascade = true,
+		.region_count = 97,
+	};
+	size_t count = 29;
+
+	data = kunit_kzalloc(test, TEST_FW_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	make_minimal(data, TEST_FW_SIZE);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, 4095, &sw_options, &count),
+			-EMSGSIZE);
+	KUNIT_EXPECT_EQ(test, count, (size_t)29);
+	data[TEST_FW_SIZE - 4096 + 1] = 0xab;
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EBADMSG);
+	KUNIT_EXPECT_EQ(test, count, (size_t)29);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_parse_layout(data, TEST_FW_SIZE, &sw_options,
+						 &layout), -EBADMSG);
+	KUNIT_EXPECT_TRUE(test, layout.cascade);
+	KUNIT_EXPECT_EQ(test, layout.region_count, (size_t)97);
+}
+
+static void nt36523n_fw_exact_end_test(struct kunit *test)
+{
+	u8 *data;
+	struct nt36523n_fw_region regions[2];
+	size_t count;
+
+	data = kunit_kzalloc(test, TEST_FW_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	make_minimal(data, TEST_FW_SIZE);
+	set_fixed(data, 1, TEST_FW_SIZE - 2, 0x2000, 1, 0);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_parse_regions(data, TEST_FW_SIZE, &sw_options,
+						  regions, ARRAY_SIZE(regions), &count), 0);
+	KUNIT_EXPECT_EQ(test, regions[1].file_offset, TEST_FW_SIZE - 2);
+	KUNIT_EXPECT_EQ(test, regions[1].payload_len, (size_t)2);
+}
+
+static void nt36523n_fw_payload_overrun_test(struct kunit *test)
+{
+	u8 *data;
+	size_t count = 17;
+
+	data = kunit_kzalloc(test, TEST_FW_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	make_minimal(data, TEST_FW_SIZE);
+	set_fixed(data, 1, TEST_FW_SIZE - 1, 0x2000, 1, 0);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EMSGSIZE);
+	KUNIT_EXPECT_EQ(test, count, (size_t)17);
+}
+
+static void nt36523n_fw_size_and_reserved_test(struct kunit *test)
+{
+	u8 *data;
+	struct nt36523n_fw_region regions[2];
+	size_t count;
+
+	data = kunit_kzalloc(test, TEST_FW_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	make_minimal(data, TEST_FW_SIZE);
+	set_fixed(data, 0, 0x30, 0x1000, 1, 0);
+	set_fixed(data, 1, 0xffffffff, 0xffffffff, 0, 0xffffffff);
+	KUNIT_ASSERT_EQ(test,
+			nt36523n_fw_parse_regions(data, TEST_FW_SIZE, &hw_options,
+						  regions, ARRAY_SIZE(regions), &count), 0);
+	KUNIT_EXPECT_FALSE(test, regions[0].reserved);
+	KUNIT_EXPECT_EQ(test, regions[0].payload_len, (size_t)2);
+	KUNIT_EXPECT_TRUE(test, regions[1].reserved);
+	KUNIT_EXPECT_EQ(test, regions[1].payload_len, (size_t)0);
+	KUNIT_EXPECT_EQ(test, regions[1].file_offset, (size_t)0);
+	KUNIT_EXPECT_EQ(test, regions[1].sram_addr, (u32)0);
+}
+
+static void nt36523n_fw_sram_overflow_test(struct kunit *test)
+{
+	u8 *data;
+	size_t count = 23;
+
+	data = kunit_kzalloc(test, TEST_FW_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	make_minimal(data, TEST_FW_SIZE);
+	set_fixed(data, 1, 0x40, U32_MAX, 1, 0);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EOVERFLOW);
+	KUNIT_EXPECT_EQ(test, count, (size_t)23);
+}
+
+static void nt36523n_fw_header_layout_test(struct kunit *test)
+{
+	u8 *data;
+	size_t count;
+
+	data = kunit_kzalloc(test, TEST_FW_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	make_minimal(data, TEST_FW_SIZE);
+	put_unaligned_le32(0x31, data);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EBADMSG);
+
+	make_minimal(data, TEST_FW_SIZE);
+	put_unaligned_le32(TEST_FW_SIZE + 1, data);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EMSGSIZE);
+
+	make_minimal(data, TEST_FW_SIZE);
+	put_unaligned_le32(0x20, data);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EBADMSG);
+}
+
+static void nt36523n_fw_header_region_overrun_test(struct kunit *test)
+{
+	u8 *data;
+	size_t count;
+
+	data = kunit_kzalloc(test, TEST_FW_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	make_minimal(data, TEST_FW_SIZE);
+	put_unaligned_le32(0x40, data);
+	set_desc(data, 0x30, 0, 0x10, 0x38, 0);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EBADMSG);
+
+	make_minimal(data, TEST_FW_SIZE);
+	put_unaligned_le32(0x40, data);
+	set_desc(data, 0x30, 0, 0x3f, 0, 0);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EBADMSG);
+}
+
+static void nt36523n_fw_cascade_test(struct kunit *test)
+{
+	u8 *data;
+	struct nt36523n_fw_region regions[4];
+	struct nt36523n_fw_layout layout;
+	size_t count;
+
+	data = kunit_kzalloc(test, TEST_FW_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	make_cascade(data, TEST_FW_SIZE);
+	KUNIT_ASSERT_EQ(test,
+			nt36523n_fw_parse_regions(data, TEST_FW_SIZE, &hw_options,
+						  regions, ARRAY_SIZE(regions), &count), 0);
+	KUNIT_EXPECT_EQ(test, count, (size_t)4);
+	KUNIT_EXPECT_EQ(test, regions[2].kind, NT36523N_FW_REGION_HEADER);
+	KUNIT_EXPECT_EQ(test, regions[2].file_offset, (size_t)0);
+	KUNIT_EXPECT_EQ(test, regions[2].payload_len, (size_t)0x40);
+	KUNIT_EXPECT_EQ(test, regions[3].kind, NT36523N_FW_REGION_HEADER);
+	KUNIT_EXPECT_EQ(test, regions[3].file_offset, (size_t)0x40);
+	KUNIT_ASSERT_EQ(test,
+			nt36523n_fw_parse_layout(data, TEST_FW_SIZE, &hw_options,
+						 &layout), 0);
+	KUNIT_EXPECT_TRUE(test, layout.cascade);
+	KUNIT_EXPECT_EQ(test, layout.region_count, (size_t)4);
+}
+
+static void nt36523n_fw_cascade_marker_test(struct kunit *test)
+{
+	u8 *data;
+	size_t count;
+
+	data = kunit_kzalloc(test, TEST_FW_SIZE, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, data);
+	make_cascade(data, TEST_FW_SIZE);
+	set_desc(data, 0x30, 0, 0, 0, 0);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EBADMSG);
+
+	make_cascade(data, TEST_FW_SIZE);
+	set_desc(data, 0x30, 0, 0x3f, 1, 0);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EBADMSG);
+
+	make_cascade(data, TEST_FW_SIZE);
+	set_desc(data, 0x30, 0, 0x3e, 0, 0);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EBADMSG);
+
+	make_cascade(data, TEST_FW_SIZE);
+	set_desc(data, 0x70, 0, 0x3f, 0x41, 0);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EBADMSG);
+
+	make_cascade(data, TEST_FW_SIZE);
+	set_desc(data, 0x70, 0, 0x3e, 0x40, 0);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EBADMSG);
+
+	make_cascade(data, TEST_FW_SIZE);
+	set_desc(data, 0x70, 0, 1, 0x80, 0);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EBADMSG);
+
+	make_minimal(data, TEST_FW_SIZE);
+	put_unaligned_le32(0xa0, data);
+	data[0x20] = BIT(1);
+	set_desc(data, 0x30, 0, 0x0f, 0, 0);
+	set_desc(data, 0x40, 0, 0x0f, 0, 0);
+	set_desc(data, 0x90, 0, 0x0f, 0x40, 0);
+	KUNIT_EXPECT_EQ(test,
+			nt36523n_fw_count_regions(data, TEST_FW_SIZE, &sw_options,
+						  &count), -EBADMSG);
+}
+
