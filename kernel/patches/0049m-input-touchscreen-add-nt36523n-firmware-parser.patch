+static void nt36523n_fw_overlay_test(struct kunit *test)
+{
+	u8 *data;
+	struct nt36523n_fw_region regions[3];
+	size_t count;
+
+	data = kunit_kzalloc(test, TEST_FW_SIZE, GFP_KERNEL);
