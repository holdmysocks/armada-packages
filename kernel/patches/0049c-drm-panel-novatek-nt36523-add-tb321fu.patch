+static int kirby_csot_init_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_device *dsi0 = pinfo->dsi[0];
+	struct mipi_dsi_device *dsi1 = pinfo->dsi[1];
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = NULL };
+
+	/* Lenovo TB321FU Android qcom,mdss_dsi_kirby_nt36523_csot_dsc_vid */
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x10);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf0, 0xaa);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf1, 0x55);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf2, 0x99);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x25);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x0f, 0x20);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x27);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xd0, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xd1, 0x54);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xde, 0x03);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xdf, 0x02);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0xd0);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x00, 0x30);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x09, 0xee);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x1c, 0x99);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x1d, 0x09);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0xf0);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x24, 0x02);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x25);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x17, 0xcf);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x19, 0x1f);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x1b, 0x5b);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x1c, 0xf0);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf2, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf3, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x10);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x35, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x51, 0x07, 0xff);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x53, 0x2c);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x55, 0x00);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x90, 0x03);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x91,
+					  0x89, 0x28, 0x00, 0x14, 0xc2, 0x00, 0x02,
+					  0x91, 0x02, 0x47, 0x00, 0x0b, 0x05, 0x0e,
+					  0x03, 0x68);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x92, 0x10, 0xe0);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xb2, 0x91);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xb3, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xbb, 0x13);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0x3b,
+					  0x03, 0x04, 0x1e, 0x04, 0x04, 0x01);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 105);
+
+	return dsi_ctx.accum_err;
+}
+
+static int kirby_csot_post_dsc_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_device *dsi0 = pinfo->dsi[0];
+	struct mipi_dsi_device *dsi1 = pinfo->dsi[1];
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = NULL };
+
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, MIPI_DCS_SET_DISPLAY_ON);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xff, 0x10);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xfb, 0x01);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf0, 0x55);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf1, 0xaa);
+	mipi_dsi_dual_dcs_write_seq_multi(&dsi_ctx, dsi0, dsi1, 0xf2, 0x66);
+
+	return dsi_ctx.accum_err;
+}
+
+static void kirby_csot_reset_sequence(struct panel_info *pinfo)
+{
+	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
+	usleep_range(11000, 11100);
+	gpiod_set_value_cansleep(pinfo->reset_gpio, 0);
+	usleep_range(1000, 1100);
+	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
+	usleep_range(3000, 3100);
+	gpiod_set_value_cansleep(pinfo->reset_gpio, 0);
+	usleep_range(10000, 10100);
+}
+
 static int j606f_boe_init_sequence(struct panel_info *pinfo)
 {
 	struct mipi_dsi_device *dsi = pinfo->dsi[0];
@@ -914,6 +1011,42 @@ static const struct drm_display_mode elish_csot_modes[] = {
 	},
 };
 
+static const struct drm_dsc_config kirby_csot_dsc = {
+	.dsc_version_major = 1,
+	.dsc_version_minor = 1,
+	.slice_height = 20,
+	.slice_width = 800,
+	.slice_count = 1,
+	.bits_per_component = 8,
+	.bits_per_pixel = 8 << 4,
+	.block_pred_enable = true,
+};
+
+static const struct drm_display_mode kirby_csot_modes[] = {
+	{
+		.clock = 791388,
+		.hdisplay = 1600,
+		.hsync_start = 1600 + 566,
+		.hsync_end = 1600 + 566 + 40,
+		.htotal = 1600 + 566 + 40 + 108,
+		.vdisplay = 2560,
+		.vsync_start = 2560 + 30,
+		.vsync_end = 2560 + 30 + 4,
+		.vtotal = 2560 + 30 + 4 + 256,
+	},
+	{
+		.clock = 791388,
+		.hdisplay = 1600,
+		.hsync_start = 1600 + 566,
+		.hsync_end = 1600 + 566 + 40,
+		.htotal = 1600 + 566 + 40 + 108,
+		.vdisplay = 2560,
+		.vsync_start = 2560 + 2880,
+		.vsync_end = 2560 + 2880 + 4,
+		.vtotal = 2560 + 2880 + 4 + 256,
+	},
+};
+
 static const struct drm_display_mode j606f_boe_modes[] = {
 	{
 		.clock = (1200 + 58 + 2 + 60) * (2000 + 26 + 2 + 93) * 60 / 1000,
@@ -966,6 +1099,30 @@ static const struct panel_desc elish_csot_desc = {
 	.is_dual_dsi = true,
 };
 
+static const struct panel_desc kirby_csot_desc = {
+	.modes = kirby_csot_modes,
+	.num_modes = ARRAY_SIZE(kirby_csot_modes),
+	.dsc = &kirby_csot_dsc,
+	.dsi_info = {
+		.type = "nt36523-kirby",
+		.channel = 0,
+		.node = NULL,
+	},
+	.width_mm = 118,
+	.height_mm = 190,
+	.bpc = 8,
+	.lanes = 3,
+	.format = MIPI_DSI_FMT_RGB888,
+	.mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+		      MIPI_DSI_MODE_NO_EOT_PACKET |
+		      MIPI_DSI_CLOCK_NON_CONTINUOUS | MIPI_DSI_MODE_LPM,
+	.init_sequence = kirby_csot_init_sequence,
+	.post_dsc_sequence = kirby_csot_post_dsc_sequence,
+	.reset_sequence = kirby_csot_reset_sequence,
+	.is_dual_dsi = true,
+	.has_bias_regulators = true,
+};
+
 static const struct panel_desc j606f_boe_desc = {
 	.modes = j606f_boe_modes,
 	.num_modes = ARRAY_SIZE(j606f_boe_modes),
@@ -980,6 +1137,80 @@ static const struct panel_desc j606f_boe_desc = {
 	.has_dcs_backlight = true,
 };
 
+static int nt36523_enable_dsc(struct panel_info *pinfo)
+{
+	struct drm_dsc_config pps_dsc = pinfo->dsc;
+	struct drm_dsc_picture_parameter_set pps;
+	int i;
+
+	/* Each physical DSI sink receives one 800-pixel slice. */
+	pps_dsc.pic_width = pps_dsc.slice_width;
+	pps_dsc.slice_count = 1;
+	drm_dsc_pps_payload_pack(&pps, &pps_dsc);
+
+	for (i = 0; i < DSI_NUM_MIN + pinfo->desc->is_dual_dsi; i++) {
+		struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi[i] };
+
+		mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+		if (dsi_ctx.accum_err)
+			return dev_err_probe(pinfo->panel.dev, dsi_ctx.accum_err,
+					     "failed to transmit DSC PPS on DSI%d\n", i);
+	}
+
+	for (i = 0; i < DSI_NUM_MIN + pinfo->desc->is_dual_dsi; i++) {
+		struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi[i] };
+
+		mipi_dsi_compression_mode_multi(&dsi_ctx, true);
+		if (dsi_ctx.accum_err)
+			return dev_err_probe(pinfo->panel.dev, dsi_ctx.accum_err,
+					     "failed to enable DSC on DSI%d\n", i);
+	}
+
+	return 0;
+}
+
+static void nt36523_power_off(struct panel_info *pinfo)
+{
+	if (pinfo->desc->has_bias_regulators) {
+		regulator_disable(pinfo->enn);
+		usleep_range(5000, 5100);
+		regulator_disable(pinfo->enp);
+		usleep_range(5000, 5100);
+	}
+
+	regulator_disable(pinfo->vddio);
+}
+
+static int nt36523_power_on(struct panel_info *pinfo)
+{
+	int ret;
+
+	ret = regulator_enable(pinfo->vddio);
+	if (ret)
+		return ret;
+
+	if (!pinfo->desc->has_bias_regulators)
+		return 0;
+
+	ret = regulator_enable(pinfo->enp);
+	if (ret)
+		goto disable_vddio;
+	usleep_range(5000, 5100);
+
+	ret = regulator_enable(pinfo->enn);
+	if (ret)
+		goto disable_enp;
+	usleep_range(11000, 11100);
+
+	return 0;
+
+disable_enp:
+	regulator_disable(pinfo->enp);
+disable_vddio:
+	regulator_disable(pinfo->vddio);
+	return ret;
+}
+
 static void nt36523_reset(struct panel_info *pinfo)
 {
 	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
@@ -997,21 +1228,41 @@ static int nt36523_prepare(struct drm_panel *panel)
 	struct panel_info *pinfo = to_panel_info(panel);
 	int ret;
 
-	ret = regulator_enable(pinfo->vddio);
+	ret = nt36523_power_on(pinfo);
 	if (ret) {
-		dev_err(panel->dev, "failed to enable vddio regulator: %d\n", ret);
+		dev_err(panel->dev, "failed to enable panel supplies: %d\n", ret);
 		return ret;
 	}
 
-	nt36523_reset(pinfo);
+	if (pinfo->desc->reset_sequence)
+		pinfo->desc->reset_sequence(pinfo);
+	else
+		nt36523_reset(pinfo);
 
 	ret = pinfo->desc->init_sequence(pinfo);
 	if (ret < 0) {
-		regulator_disable(pinfo->vddio);
+		nt36523_power_off(pinfo);
 		dev_err(panel->dev, "failed to initialize panel: %d\n", ret);
 		return ret;
 	}
 
+	if (pinfo->desc->dsc) {
+		ret = nt36523_enable_dsc(pinfo);
+		if (ret < 0) {
+			nt36523_power_off(pinfo);
+			return ret;
+		}
+	}
+
+	if (pinfo->desc->post_dsc_sequence) {
+		ret = pinfo->desc->post_dsc_sequence(pinfo);
+		if (ret < 0) {
+			nt36523_power_off(pinfo);
+			dev_err(panel->dev, "failed to finish panel initialization: %d\n", ret);
+			return ret;
+		}
+	}
+
 	return 0;
 }
 
@@ -1042,7 +1293,7 @@ static int nt36523_unprepare(struct drm_panel *panel)
 	struct panel_info *pinfo = to_panel_info(panel);
 
 	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
-	regulator_disable(pinfo->vddio);
+	nt36523_power_off(pinfo);
 
 	return 0;
 }
@@ -1181,6 +1432,21 @@ static int nt36523_probe(struct mipi_dsi_device *dsi)
 	if (!pinfo->desc)
 		return -ENODEV;
 
+	if (pinfo->desc->has_bias_regulators) {
+		pinfo->enp = devm_regulator_get(dev, "enp");
+		if (IS_ERR(pinfo->enp))
+			return dev_err_probe(dev, PTR_ERR(pinfo->enp),
+					     "failed to get enp regulator\n");
+
+		pinfo->enn = devm_regulator_get(dev, "enn");
+		if (IS_ERR(pinfo->enn))
+			return dev_err_probe(dev, PTR_ERR(pinfo->enn),
+					     "failed to get enn regulator\n");
+	}
+
+	if (pinfo->desc->dsc)
+		pinfo->dsc = *pinfo->desc->dsc;
+
 	/* If the panel is dual dsi, register DSI1 */
 	if (pinfo->desc->is_dual_dsi) {
 		info = &pinfo->desc->dsi_info;
@@ -1231,6 +1497,8 @@ static int nt36523_probe(struct mipi_dsi_device *dsi)
 		pinfo->dsi[i]->lanes = pinfo->desc->lanes;
 		pinfo->dsi[i]->format = pinfo->desc->format;
 		pinfo->dsi[i]->mode_flags = pinfo->desc->mode_flags;
+		if (pinfo->desc->dsc)
+			pinfo->dsi[i]->dsc = &pinfo->dsc;
 
 		ret = devm_mipi_dsi_attach(dev, pinfo->dsi[i]);
 		if (ret < 0)
@@ -1241,6 +1509,22 @@ static int nt36523_probe(struct mipi_dsi_device *dsi)
 }
 
