From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: tb321fu: clean downstream properties

Replace the PTN3222 opaque downstream parameter array with the Lenovo
fallback compatible, remove the undocumented PS5169 fallback, and drop the
two downstream DWC3 host properties whose lifecycle-altering driver changes
are not carried. Also remove properties with no upstream consumers, correct
the PM8550B eUSB2 squelch property name, add required reserved-memory unit
addresses, and remove panel-name, which the NT36523 driver and common panel
binding do not consume.

Describe the touchscreen with the upstream-style NT36523N compatible and
standard interrupt and reset properties. Drop the duplicate downstream GPIO
properties and the controller register and pen properties that have no
binding or upstream driver contract.

diff --git a/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb321fu.dts b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb321fu.dts
--- a/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb321fu.dts
+++ b/arch/arm64/boot/dts/qcom/sm8650-lenovo-tb321fu.dts
@@ -63,2 +63,0 @@
-				c2-select-gpios = <&tlmm 58 GPIO_ACTIVE_HIGH>;
-				secondary-audio-detect-gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
@@ -775,14 +773,13 @@
 	status = "okay";
 
 	eusb2_repeater: redriver@4f {
-		compatible = "nxp,ptn3222";
+		compatible = "lenovo,tb321fu-ptn3222", "nxp,ptn3222";
 		reg = <0x4f>;
 
 		vdd1v8-supply = <&vreg_l15b_1p8>;
 		vdd3v3-supply = <&vreg_l5b_3p1>;
 
 		reset-gpios = <&pm8550vs_c_gpios 4 GPIO_ACTIVE_LOW>;
-		qcom,param-override-seq-c1 = /bits/ 8 <0x40 0x06 0x22 0x07 0x65 0x08 0x03 0x0a>;
 
 		#phy-cells = <0>;
 	};
@@ -823,1 +820,1 @@
-			compatible = "parade,ps5169", "hq_redriver,ps5169";
+			compatible = "parade,ps5169";
@@ -968,7 +965,6 @@
 			     "lenovo,tb321fu-kirby-nt36523-csot-dsc",
 			     "lenovo,kirby-nt36523-csot-dsc";
 		reg = <0>;
-		panel-name = "kirby_nt36523_csot_dsc_vid";
 		vddio-supply = <&panel_iovdd>;
 		enp-supply = <&panel_enp>;
 		enn-supply = <&panel_enn>;
@@ -1013,1 +1009,0 @@
-	qcom,mdss-dsi-panel-phy-timings = [00 00 00 00 23 22 08 19 08 02 04 00 00 00];
@@ -1037,1 +1032,0 @@
-	qcom,mdss-dsi-panel-phy-timings = [00 00 00 00 23 22 08 19 08 02 04 00 00 00];
@@ -1130,1 +1124,1 @@
-	qcom,squelch-detector = <(-4000)>;
+	qcom,squelch-detector-bp = <(-4000)>;
@@ -1177,1 +1171,1 @@
-	lost_reg_mem: lost-reg-mem {
+	lost_reg_mem: lost-reg-mem@9b09c000 {
@@ -1187,1 +1181,1 @@
-	splash_region: splash-region {
+	splash_region: splash-region@d5100000 {
@@ -1202,3 +1196,1 @@
-		compatible = "lenovo,tb321fu-nt36523n-spi",
-			     "novatek,nt36523n-spi",
-			     "novatek,NVT-ts-spi";
+		compatible = "novatek,nt36523n";
@@ -1207,4 +1199,2 @@
-		reset-gpios = <&tlmm 161 GPIO_ACTIVE_HIGH>;
-		irq-gpio = <&tlmm 162 GPIO_ACTIVE_LOW>;
-		novatek,reset-gpio = <&tlmm 161 GPIO_ACTIVE_HIGH>;
-		novatek,irq-gpio = <&tlmm 162 GPIO_ACTIVE_LOW>;
+		interrupts-extended = <&tlmm 162 IRQ_TYPE_EDGE_RISING>;
+		reset-gpios = <&tlmm 161 GPIO_ACTIVE_LOW>;
@@ -1216,3 +1206,0 @@
-		novatek,swrst-n8-addr = <0x03f0fe>;
-		novatek,spi-rd-fast-addr = <0x03f310>;
-		novatek,pen-support;
@@ -1585,8 +1572,6 @@
 	usb-role-switch;
 	role-switch-default-mode = "host";
 	qcom,select-utmi-as-pipe-clk;
-	qcom,host-ss-powerup-quirk;
-	qcom,host-usb2-phy-reinit-quirk;
 
 	status = "okay";
 };
